{
  "info": {
    "_postman_id": "8c5fd196-857c-4861-a0a3-d02f5db3e84a",
    "name": "RetailIQ Metrics & Analytics API",
    "description": "This Postman collection is designed to test the Metrics and Dashboard Analytics endpoints of the RetailIQ backend. It includes automated token authentication logic using collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "System & Utilities",
      "item": [
        {
          "name": "Home Endpoint",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ""
              ]
            },
            "description": "Checks if the API server is up and running."
          },
          "response": []
        },
        {
          "name": "Database Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/db-health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "db-health"
              ]
            },
            "description": "Verifies if the database connection is healthy."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "User Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set(\"authToken\", jsonData.access_token);",
                  "    console.log(\"Saved authToken variable:\", jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{userEmail}}\",\n    \"password\": \"{{userPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Logs in the user and automatically stores the JWT access token in the collection variable `authToken` for subsequent dashboard requests."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Metrics & Dashboard",
      "item": [
        {
          "name": "Numeric Summary Metrics",
          "request": {
            "method": "GET",
            "header": [],
