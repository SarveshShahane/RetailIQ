              "query": [
                {
                  "key": "business_id",
                  "value": "{{businessId}}",
                  "description": "The ID of the business to query metrics for"
                },
                {
                  "key": "time",
                  "value": "{{timeframe}}",
                  "description": "Time duration filter: today, week, month, year, all (Default: month)"
                }
              ]
            },
            "description": "Returns general numeric metrics including total sales, total invoices count, and recent customer count."
